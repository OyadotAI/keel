{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: open a folder, open a link, update and restart itself, and nothing else from the host.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "allow-open-project",
    "allow-close-project",
    "allow-stop-all",
    "allow-scratch-dir",
    "allow-sign-packet",
    "allow-save-text",
    "allow-is-dir",
    "allow-preview-show",
    "allow-preview-bounds",
    "allow-preview-hide",
    "allow-preview-send"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window's own page: open a folder, open a link, zoom, update and restart itself, and nothing else from the host. By webview, not by window: a window grant reaches every child webview in it, and the preview is one.",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "allow-open-project",
    "allow-close-project",
    "allow-stop-all",
    "allow-scratch-dir",
    "allow-sign-packet",
    "allow-save-text",
    "allow-is-dir",
    "allow-preview-show",
    "allow-preview-bounds",
    "allow-preview-hide",
    "allow-preview-send"
  ]
}

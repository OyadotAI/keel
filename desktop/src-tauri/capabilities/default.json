{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: open a folder, open a link, update and restart itself, and nothing else from the host.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}

# Generated by Keel.
#
# Cloudflare Container disk is EPHEMERAL. Cloudflare's own words: "All disk is ephemeral. When a
# Container instance goes to sleep, the next time it is started, it will have a fresh disk as
# defined by its container image." Default sleepAfter is 10 minutes.
#
# Nothing written to this filesystem survives. Durable state belongs in D1, R2, a Durable Object,
# or a managed Postgres behind Hyperdrive — never here.
FROM oven/bun:1-alpine AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build

FROM oven/bun:1-alpine
WORKDIR /app
# Non-root: the container runs untrusted-by-default workloads and has no reason to be root.
RUN addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /app/dist ./dist
COPY --from=build --chown=app:app /app/node_modules ./node_modules
USER app

# Shutdown is SIGTERM, a 15-minute grace period, then SIGKILL. Drain in-flight work on SIGTERM
# rather than relying on the grace period expiring.
STOPSIGNAL SIGTERM
EXPOSE 8080
CMD ["bun", "run", "dist/index.js"]

{
  // Two environments exist from the first deploy. A project with one environment teaches you to
  // test in production, and no approval gate downstream recovers from that.
  //
  // Every stateful binding below is DISTINCT per environment. Sharing a database_id, KV id or
  // bucket_name between dev and prod is the single most common way a safe-looking action in dev
  // destroys real data — Keel will not generate it, and flags it as critical when it finds it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{project}}",
  "main": "src/index.ts",
  "compatibility_date": "{{compatibility_date}}",
  "compatibility_flags": ["nodejs_compat"],

  // Traces are exported by Cloudflare's native Workers tracing rather than an SDK in the bundle.
  // The community otel-cf-workers package is no longer the recommended path; its own maintainer
  // now points users at the built-in exporter.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "env": {
    "dev": {
      "name": "{{project}}-dev",
      "routes": [{ "pattern": "dev.{{domain}}", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "dev" },
      "d1_databases": [
        { "binding": "DB", "database_name": "{{project}}-dev", "database_id": "{{d1_dev_id}}" }
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "{{kv_dev_id}}" }],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "{{project}}-uploads-dev" }]
    },

    "prod": {
      "name": "{{project}}-prod",
      "routes": [{ "pattern": "{{domain}}", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "prod" },
      "d1_databases": [
        { "binding": "DB", "database_name": "{{project}}-prod", "database_id": "{{d1_prod_id}}" }
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "{{kv_prod_id}}" }],
      "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "{{project}}-uploads-prod" }]
    }
  }
}
